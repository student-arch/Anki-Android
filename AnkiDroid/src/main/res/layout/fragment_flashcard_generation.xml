<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/close_icon"
        app:title="@string/menu_generate_flashcards"
        app:titleTextAppearance="@style/TextAppearance.AnkiDroid.TopAppBar.Title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 1: input -->
        <ScrollView
            android:id="@+id/input_step"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <TextView
                android:id="@+id/setup_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorErrorContainer"
                android:padding="12dp"
                android:text="@string/ai_setup_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/select_provider_model"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/ai_model_none_selected"
                tools:text="Test Provider · test-model" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/generate_images"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/ai_generate_images_label"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/select_image_provider_model"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/ai_images_off"
                tools:text="Test Provider · image-model" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/ai_material_label"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.ichi2.ui.FixedEditText
                android:id="@+id/material"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/ai_material_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                tools:text="Photosynthesis is the process by which plants convert light energy into chemical energy..." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/ai_card_count_label"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.ichi2.ui.FixedEditText
                android:id="@+id/count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789"
                android:importantForAutofill="no"
                android:inputType="number"
                android:text="@string/ai_default_card_count" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/generate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/menu_generate_flashcards" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 2: review -->
        <LinearLayout
            android:id="@+id/review_step"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/select_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/card_browser_select_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deselect_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ai_deselect_all" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_failed"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/try_again"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cards"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="16dp"
                tools:listitem="@layout/item_generated_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_images"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/ai_change_images" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/choose_deck"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/ai_choose_deck" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_cards"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    tools:text="Add 3 cards" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/deck_target_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <RadioButton
                    android:id="@+id/existing_deck_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/ai_existing_deck_option" />

                <TextView
                    android:id="@+id/existing_deck_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="32dp"
                    android:text="@string/ai_no_deck_selected"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <RadioButton
                    android:id="@+id/new_deck_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_new_deck_option" />

                <com.ichi2.ui.FixedEditText
                    android:id="@+id/new_deck_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ai_new_deck_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="32dp"
                    android:visibility="gone" />
            </RadioGroup>
        </LinearLayout>

        <!-- progress -->
        <LinearLayout
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/generating_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ai_generating"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/adding_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Step 3: done -->
        <LinearLayout
            android:id="@+id/done_step"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle_24"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/done_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="10 cards added to Default" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/multimedia_editor_field_editing_done" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
